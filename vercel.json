{
    "version": 2,
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build"
        },
        {
            "src": "backend/app/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/docs",
            "dest": "backend/app/main.py"
        },
        {
            "src": "/openapi.json",
            "dest": "backend/app/main.py"
        },
        {
            "src": "/redoc",
            "dest": "backend/app/main.py"
        },
        {
            "src": "/api/(.*)",
            "dest": "backend/app/main.py"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/$1"
        }
    ]
}